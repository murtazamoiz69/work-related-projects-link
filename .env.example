# PUBLIC frontend configuration only.
#
# Every VITE_-prefixed value is embedded in the client bundle and is therefore
# PUBLIC — readable by anyone who loads the app. NEVER put a secret here
# (API keys, DB credentials, JWT signing secrets, OAuth client secrets, any
# third-party server token). Secrets belong on the backend.
#
# Copy this file to .env and adjust as needed. Missing values fall back to safe
# development defaults (the app will not crash without a .env).

# Base URL of the backend API. The real backend serves under /api/v1.
#   Real:  https://nws-api.underdev.in/api/v1
#   Mock:  http://localhost:3000  (any value; MSW intercepts by path)
VITE_API_URL=http://localhost:3000

# development | staging | production
VITE_APP_ENV=development

# Serve API calls from MSW mocks instead of a real backend.
# Unset -> on in dev, off in production. Set explicitly to override.
# VITE_USE_MOCKS=true

# Per-feature migration switch: comma-separated features that should hit the
# REAL backend (their mocks are skipped) while everything else stays mocked.
# Empty/unset = all mocked (keeps the offline demo working).
# To run auth + Users + Nutritionists against the real API in dev, use a
# .env.local. The backend's CORS allowlist excludes localhost, so go through
# the dev proxy: point the base at a same-origin path and set a proxy target.
#   VITE_API_URL=/api/v1
#   VITE_API_PROXY_TARGET=https://nws-api.underdev.in
#   VITE_USE_MOCKS=true
#   VITE_LIVE_APIS=auth,clients,nutritionists
# VITE_LIVE_APIS=auth,clients,nutritionists

# Dev-only: reverse-proxy /api to this backend so the browser stays same-origin
# (bypasses the backend CORS allowlist). Only used by `vite dev`.
# VITE_API_PROXY_TARGET=https://nws-api.underdev.in
