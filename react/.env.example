# PUBLIC frontend configuration only.
#
# Every VITE_-prefixed value is embedded in the client bundle and is therefore
# PUBLIC — readable by anyone who loads the app. NEVER put a secret here
# (API keys, DB credentials, JWT signing secrets, OAuth client secrets, any
# third-party server token). Secrets belong on the backend.
#
# Copy this file to .env and adjust as needed. Missing values fall back to safe
# development defaults (the app will not crash without a .env).

# Base URL of the backend API.
VITE_API_URL=http://localhost:3000

# development | staging | production
VITE_APP_ENV=development

# Serve API calls from MSW mocks instead of a real backend.
# Unset -> on in dev, off in production. Set explicitly to override.
# VITE_USE_MOCKS=true
