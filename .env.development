# Shared DEV config (committed; Vite loads it only in `vite dev`, never in the
# production/demo build or under vitest's `test` mode). This runs the migrated
# features against the real backend through the dev proxy, so every dev checkout
# behaves the same without a per-machine env file.
#
# The backend's CORS allowlist excludes localhost, so we stay same-origin: the
# base is a path and Vite proxies /api to the backend (see vite.config.ts).
#
# To run everything on mocks instead (offline), override in a gitignored
# .env.development.local with: VITE_LIVE_APIS=
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=https://nws-api.underdev.in
VITE_USE_MOCKS=true
VITE_LIVE_APIS=auth,clients,nutritionists,dashboard
