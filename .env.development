# Shared DEV config (committed). Vite loads it in DEVELOPMENT mode — `vite dev`
# and `vite build --mode development` (the "dev build", `npm run build:dev`) —
# never in the production build or under vitest's `test` mode. So every dev
# checkout behaves the same without a per-machine env file.
#
# The backend now allows localhost (CORS fixed), so the browser talks to it
# DIRECTLY — no dev proxy. The migrated features (VITE_LIVE_APIS) hit the real
# backend; MSW runs (VITE_USE_MOCKS=true) to serve the features the backend
# hasn't built yet — Programs content, Chat, and the Plan Workspace. Those stay
# mocked until their endpoints exist; the rest is real. Setting the flag here
# (rather than relying on the dev default) also makes a `--mode development`
# BUILD behave like local, since a build otherwise runs with mocks off.
#
# To run everything on mocks instead (fully offline), override in a gitignored
# .env.development.local with: VITE_LIVE_APIS=
VITE_API_URL=https://nws-api.underdev.in/api/v1
VITE_USE_MOCKS=true
VITE_LIVE_APIS=auth,clients,nutritionists,dashboard
