# Shared DEV config (committed). Vite loads it in DEVELOPMENT mode — `vite dev`
# and `vite build --mode development` (the "dev build", `npm run build:dev`) —
# never in the production build or under vitest's `test` mode. So every dev
# checkout behaves the same without a per-machine env file.
#
# The backend allows localhost (CORS fixed), so the browser talks to it DIRECTLY
# — no dev proxy. Features in VITE_LIVE_APIS hit the real backend; MSW
# (VITE_USE_MOCKS=true) still serves what's mock-only — Chat, and (inside the
# Plan Workspace) the Activity tab, which has no real conversation source yet.
# Setting the flag here (rather than the dev default) also makes a
# `--mode development` BUILD behave like local.
#
# Flags:
#   program          GET/PUT /program + PATCH /program/availability
#   program-workout  /program/workout-plan*  (global master plan)
#   program-diet     /program/diet-plan*     (global master sheets)
#   libraries        GET /libraries/calorie-bands
#   plan-workspace   GET/PUT /clients/:id/plan + /clients/:id/workout-plan* +
#                    /clients/:id/diet-plan* + diet-band + diet-review
#   client-detail    GET /clients/:id/detail (the "At a glance" tracker)
#
# To run everything on mocks instead (fully offline), override in a gitignored
# .env.development.local with: VITE_LIVE_APIS=
VITE_API_URL=https://nws-api.underdev.in/api/v1
VITE_USE_MOCKS=true
VITE_LIVE_APIS=auth,clients,nutritionists,dashboard,program,program-workout,program-diet,libraries,plan-workspace,client-detail
