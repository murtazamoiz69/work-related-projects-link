# Production frontend configuration (loaded by `vite build`, i.e. production
# mode). Every VITE_-prefixed value is embedded in the client bundle and is
# therefore PUBLIC — readable by anyone who loads the app. NEVER put a secret
# here (API keys, DB credentials, JWT signing secrets). Secrets live on the
# backend. See .env.example for the full reference.

# The real backend, served under /api/v1. In production the browser calls this
# host directly (no dev proxy), so the backend's CORS allowlist MUST include the
# production frontend's origin.
VITE_API_URL=https://nws-api.underdev.in/api/v1

VITE_APP_ENV=production

# Mocks OFF in production — every request goes to the real backend above.
VITE_USE_MOCKS=false

# VITE_LIVE_APIS is only consulted when mocks are ON, so it has no effect here
# and is intentionally omitted. The dev-only reverse proxy (VITE_API_PROXY_TARGET)
# is likewise not used in a production build.
