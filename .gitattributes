# Normalize line endings across platforms.
# Text files are stored with LF in the repo; Git converts on checkout per the
# user's core.autocrlf. This stops Windows CRLF checkouts from showing every
# file as "modified" and keeps diffs clean. Prettier's endOfLine:"auto"
# (.prettierrc.json) accepts whatever the working tree uses.
* text=auto

# Explicit text types (belt-and-suspenders).
*.ts    text
*.tsx   text
*.js    text
*.jsx   text
*.json  text
*.css   text
*.html  text
*.md    text
*.svg   text

# Binary files — never normalize or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
